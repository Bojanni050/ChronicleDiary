# ChronicleDiary Environment Configuration

# Express backend port
PORT=3001

# PostgreSQL connection string (local or Docker container)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chronicle_diary

# Frontend API URL (leave blank when served by backend on same host)
VITE_API_URL=

# Optional Hindsight integration endpoints
# HINDSIGHT_ENDPOINT=https://api.hindsight.example.com/v1/entries
# HINDSIGHT_API_KEY=your_hindsight_api_key_here
